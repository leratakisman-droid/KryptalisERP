      <TextObject Name="ClientInfo" Top="18.9" Width="718.2" Height="37.8" Text="[SalesInvoices.ClientName]&#13;&#10;ΑΦΜ: [SalesInvoices.ClientVat]&#13;&#10;[SalesInvoices.ClientAddress], [SalesInvoices.ClientCity]&#13;&#10;Τηλ: [SalesInvoices.ClientPhone]" Font="Arial, 10pt"/>
    </PageHeaderBand>
    <DataBand Name="ItemsBand" Top="133.4" Width="718.2" Height="18.9" DataSource="InvoiceItems">
      <TextObject Name="Desc" Width="359.1" Height="18.9" Text="[InvoiceItems.Description]" Font="Arial, 9pt"/>
      <TextObject Name="Qty" Left="359.1" Width="75.6" Height="18.9" Text="[InvoiceItems.Qty] [InvoiceItems.Unit]" HorzAlign="Center" Font="Arial, 9pt"/>
      <TextObject Name="Price" Left="434.7" Width="94.5" Height="18.9" Text="[InvoiceItems.UnitPrice] €" HorzAlign="Right" Font="Arial, 9pt"/>
      <TextObject Name="Total" Left="529.2" Width="189" Height="18.9" Text="[InvoiceItems.TotalValue] €" HorzAlign="Right" Font="Arial, 9pt, style=Bold"/>
    </DataBand>
    <ReportSummaryBand Name="ReportSummary1" Top="162.3" Width="718.2" Height="75.6">
      <TextObject Name="Totals" Left="415.8" Width="302.4" Height="56.7" Text="Καθαρή Αξία: [SalesInvoices.TotalBeforeDiscount] €&#13;&#10;ΦΠΑ: [SalesInvoices.TotalVat] €&#13;&#10;━━━━━━━━━━━━━━━━━━━━&#13;&#10;ΣΥΝΟΛΟ: [SalesInvoices.GrandTotal] €" HorzAlign="Right" Font="Arial, 11pt, style=Bold"/>
      <TextObject Name="MyDataInfo" Top="56.7" Width="718.2" Height="18.9" Text="myDATA MARK: [SalesInvoices.MyDataMARK] | UID: [SalesInvoices.MyDataUID]" Font="Arial, 8pt" Fill.Color="LightGray"/>
    </ReportSummaryBand>
  </ReportPage>
</Report>