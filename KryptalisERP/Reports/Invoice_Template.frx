<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="02/10/2026" ReportInfo.Modified="02/10/2026">
  <Dictionary>
    <TableDataSource Name="SalesInvoices" ReferenceName="SalesInvoices" DataType="System.Int32" Enabled="true">
      <Column Name="DocNumber" DataType="System.String"/>
      <Column Name="DocDate" DataType="System.String"/>
      <Column Name="SeriesName" DataType="System.String"/>
      <Column Name="ClientName" DataType="System.String"/>
      <Column Name="ClientVat" DataType="System.String"/>
      <Column Name="ClientAddress" DataType="System.String"/>
      <Column Name="ClientCity" DataType="System.String"/>
      <Column Name="ClientPhone" DataType="System.String"/>
      <Column Name="TotalBeforeDiscount" DataType="System.Decimal"/>
      <Column Name="TotalVat" DataType="System.Decimal"/>
      <Column Name="TotalSurcharges" DataType="System.Decimal"/>
      <Column Name="TotalWithholdings" DataType="System.Decimal"/>
      <Column Name="GrandTotal" DataType="System.Decimal"/>
      <Column Name="MyDataMARK" DataType="System.String"/>
      <Column Name="MyDataUID" DataType="System.String"/>
      <Column Name="MyDataQRUrl" DataType="System.String"/>
    </TableDataSource>
    <TableDataSource Name="InvoiceItems" ReferenceName="InvoiceItems" DataType="System.Int32" Enabled="true">
      <Column Name="Description" DataType="System.String"/>
      <Column Name="Unit" DataType="System.String"/>
      <Column Name="Qty" DataType="System.Decimal"/>
      <Column Name="UnitPrice" DataType="System.Decimal"/>
      <Column Name="DiscountPercent" DataType="System.Decimal"/>
      <Column Name="VatRate" DataType="System.Decimal"/>
      <Column Name="NetValue" DataType="System.Decimal"/>
      <Column Name="VatValue" DataType="System.Decimal"/>
      <Column Name="TotalValue" DataType="System.Decimal"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" RawPaperSize="9">
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="56.7">
      <TextObject Name="Title" Width="718.2" Height="28.35" Text="ΤΙΜΟΛΟΓΙΟ ΠΩΛΗΣΗΣ" HorzAlign="Center" Font="Arial, 20pt, style=Bold"/>
      <TextObject Name="DocInfo" Top="28.35" Width="718.2" Height="28.35" Text="Αριθμός: [SalesInvoices.DocNumber] | Ημερομηνία: [SalesInvoices.DocDate] | Σειρά: [SalesInvoices.SeriesName]" HorzAlign="Center" Font="Arial, 11pt"/>
    </ReportTitleBand>
    <PageHeaderBand Name="PageHeader1" Top="66.7" Width="718.2" Height="56.7">
