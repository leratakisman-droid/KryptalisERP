      <TextObject Name="Price" Left="360.15" Width="94.5" Height="18.9" Text="[Items.UnitPrice] €" HorzAlign="Right" Font="Arial, 9pt"/>
      <TextObject Name="Vat" Left="454.65" Width="75.6" Height="18.9" Text="[Items.VatRate]%" HorzAlign="Center" Font="Arial, 9pt"/>
      <TextObject Name="Total" Left="530.25" Width="187.95" Height="18.9" Text="[Items.TotalValue] €" HorzAlign="Right" Font="Arial, 9pt, style=Bold"/>
    </DataBand>
    <ReportSummaryBand Name="ReportSummary1" Top="200.1" Width="718.2" Height="94.5">
      <TextObject Name="Totals" Left="415.8" Width="302.4" Height="75.6" Text="Καθαρή Αξία: [Invoice.TotalBeforeDiscount] €&#13;&#10;ΦΠΑ: [Invoice.TotalVat] €&#13;&#10;━━━━━━━━━━━━━━━━━━━━&#13;&#10;ΣΥΝΟΛΟ: [Invoice.GrandTotal] €" HorzAlign="Right" Font="Arial, 11pt, style=Bold"/>
