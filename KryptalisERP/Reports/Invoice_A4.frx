      <TextObject Name="ClientInfo" Top="18.9" Width="718.2" Height="18.9" Text="Πελάτης: [Invoice.ClientName] | ΑΦΜ: [Invoice.ClientVat] | Διεύθυνση: [Invoice.ClientAddress], [Invoice.ClientCity]" Font="Arial, 10pt"/>
    </PageHeaderBand>
    <DataBand Name="ItemsBand" Top="171.2" Width="718.2" Height="18.9" DataSource="Items">
